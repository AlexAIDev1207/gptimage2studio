# App
NEXT_PUBLIC_APP_URL=https://gptimage2studio.com
NEXT_PUBLIC_APP_NAME=GPT Image 2 Studio
NEXT_PUBLIC_APP_DESCRIPTION=Create and edit premium images with GPT Image 2 online.
NEXT_PUBLIC_DEFAULT_LOCALE=en
AUTH_URL=https://gptimage2studio.com
AUTH_SECRET=replace_with_openssl_rand_base64_32

# Database: recommended production path on Cloudflare Workers is Postgres + Hyperdrive.
DATABASE_PROVIDER=postgresql
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require
DB_SCHEMA=public
DB_SINGLETON_ENABLED=false
DB_MAX_CONNECTIONS=1

# Kie.ai provider for GPT Image 2
KIE_API_KEY=kie_xxx
KIE_BASE_URL=https://api.kie.ai/api/v1
KIE_WEBHOOK_HMAC_KEY=replace_with_kie_webhook_hmac_key
# Keep false for fast preview; R2 mirroring is handled by /api/ai/notify/kie and /api/images/mirror.
KIE_CUSTOM_STORAGE=false
GPTIMAGE2_1K_CREDITS=6
GPTIMAGE2_2K_CREDITS=10
GPTIMAGE2_4K_CREDITS=16

# Optional OpenAI fallback. Leave empty for Kie-only production.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ORGANIZATION=
OPENAI_PROJECT=
OPENAI_CUSTOM_STORAGE=true

# Cloudflare R2 via S3-compatible API used by the current R2Provider
R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_BUCKET_NAME=gptimage2studio-images
R2_UPLOAD_PATH=uploads
R2_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.cloudflarestorage.com
# Must be publicly reachable because Kie image-to-image reads input_urls from this domain.
R2_DOMAIN=https://images.gptimage2studio.com

# Stripe
DEFAULT_PAYMENT_PROVIDER=stripe
STRIPE_ENABLED=true
STRIPE_PUBLISHABLE_KEY=pk_live_xxx
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_SIGNING_SECRET=whsec_xxx
STRIPE_ALLOW_PROMOTION_CODES=true
